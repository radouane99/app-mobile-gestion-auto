<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@drawable/widget_background">
 <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="AutoCarnet" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:orientation="horizontal">
  <TextView android:id="@+id/widget_reading" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:background="@drawable/widget_action" android:gravity="center" android:text="Photo compteur" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2"/>
  <TextView android:id="@+id/widget_fuel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:background="@drawable/widget_action" android:gravity="center" android:text="Carburant" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2"/>
  <TextView android:id="@+id/widget_quick" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:background="@drawable/widget_action" android:gravity="center" android:text="Dépense rapide" android:textColor="#FFFFFF" android:textSize="13sp" android:maxLines="2"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Payé ce mois" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="2" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_due" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B9DAD4" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
 <TextView android:id="@+id/widget_oil" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B9DAD4" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
</LinearLayout>
